# Copy to .env and uncomment what you change. Every variable the app reads is listed here with its default.
# `npm run dev`, `npm start` and the catalog commands load .env; variables already set in the environment win.
# .env is git-ignored: real paths belong there, never in this file.

# HTTP and WebSocket port of the server.
# PORT=3000

# Log lines at this level and above: debug, info, warn or error.
# LOG_LEVEL=info

# Folder that holds the audio library (the AnimeThemes .ogg files). Required by the catalog build and,
# by the server for games: without it, lobbies open but no game starts. Read-only: nothing writes to it.
# YSTO_AUDIO_DIR=<folder of the audio library>

# Where catalog.sqlite and covers/ are written (and where the server reads them), and where the ingest caches live.
# YSTO_CATALOG_DIR=data/catalog
# YSTO_CACHE_DIR=data/cache

# Where npm run catalog:export writes the re-encoded library copy for the VPS. Must be outside YSTO_AUDIO_DIR.
# YSTO_EXPORT_DIR=data/export

# ffmpeg for loudness checks and clips; ffprobe is expected next to it. Defaults to the ones on PATH.
# YSTO_FFMPEG_PATH=ffmpeg

# How many reverse proxies (such as Caddy) stand in front of the server, so rate limits see player IPs.
# YSTO_TRUST_PROXY=0

# Comma-separated origins whose pages may open the socket besides the page's own, such as the Vite dev server.
# YSTO_ALLOWED_ORIGINS=http://localhost:5173

# Caps: open lobbies on the server, players per lobby, and games running at once.
# YSTO_MAX_LOBBIES=100
# YSTO_MAX_PLAYERS=12
# YSTO_MAX_GAMES=30

# A writable folder where the server keeps what it writes: the players' clip reports (reports.sqlite). Unset,
# reports are only logged. The image sets it to its state volume.
# YSTO_STATE_DIR=<writable folder>

# The daily challenge's seed secret, at least 32 characters (for example `openssl rand -base64 32`). The day's songs
# come from it and the date, so keep it private: anyone with it can list a day's answers. Unset, the daily is off.
# YSTO_DAILY_SECRET=<random secret>

# How many clips ffmpeg may cut at once. Defaults to the number of CPU cores minus one.
# YSTO_FFMPEG_CONCURRENCY=3
