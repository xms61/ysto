# Allowlist: the image build sees only what is listed here, so a new data folder stays out by default.
*
!package.json
!package-lock.json
!tsconfig*.json
!vite.config.ts
!index.html
!server/
!shared/
!src/
!public/
# The clip benchmark, which runs in the image on the VPS (docs/DEPLOY.md).
!scripts/clips/bench.ts
!scripts/catalog/cli.ts
# Tests and docs stay out of the image.
**/*.test.ts
**/*.test.tsx
**/testing/
**/*.md
