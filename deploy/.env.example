# The VPS's settings for deploy/compose.yml. Copy to .env next to compose.yml on the VPS (docs/DEPLOY.md).
# The game's own variables (LOG_LEVEL, YSTO_MAX_*, ...) may be added too; see the .env.example at the repo root.

# The domain the game is served on. Its DNS A (and AAAA) record must point at the VPS before the first start,
# so Caddy can get the certificate.
YSTO_DOMAIN=quiz.example.org

# Folders on the VPS: the exported library (npm run catalog:export) and the catalog (catalog.sqlite and covers/).
YSTO_AUDIO_HOST_DIR=/srv/ysto/audio
YSTO_CATALOG_HOST_DIR=/srv/ysto/catalog

# The image version to run, such as 0.11.0. Leave unset for the latest release; set it to roll back.
# YSTO_VERSION=
