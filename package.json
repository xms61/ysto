{
  "name": "ysto",
  "version": "0.3.0",
  "private": true,
  "description": "You Skipped The OP?! A multiplayer anime opening and ending quiz for the browser.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web \"node --env-file-if-exists=.env --watch server/main.ts\" \"vite\"",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/main.ts",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "test": "node --test \"tests/**/*.test.ts\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=\"server/**\" --test-coverage-include=\"shared/**\" --test-coverage-include=\"scripts/catalog/**\" --test-coverage-exclude=server/main.ts --test-coverage-exclude=\"scripts/catalog/bin/**\" --test-coverage-lines=85 --test-coverage-functions=85 --test-coverage-branches=75 \"tests/**/*.test.ts\"",
    "test:web": "vitest run",
    "test:e2e": "playwright test",
    "test:ci": "npm run lint && npm run format:check && npm run typecheck && npm run test:coverage && npm run test:web",
    "catalog:sync-animethemes": "node --env-file-if-exists=.env scripts/catalog/bin/sync-animethemes.ts",
    "catalog:scan-audio": "node --env-file-if-exists=.env scripts/catalog/bin/scan-audio.ts",
    "catalog:enrich-anilist": "node --env-file-if-exists=.env scripts/catalog/bin/enrich-anilist.ts",
    "catalog:covers": "node --env-file-if-exists=.env scripts/catalog/bin/covers.ts",
    "catalog:build": "node --env-file-if-exists=.env scripts/catalog/bin/build.ts",
    "catalog:check": "node --env-file-if-exists=.env scripts/catalog/bin/check.ts"
  },
  "dependencies": {
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
